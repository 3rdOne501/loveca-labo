DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Cursor Dashboard → Integrations の API key
CURSOR_API_KEY=

# local（推奨: このマシンのリポを直接編集） / cloud
AGENT_RUNTIME=local
CURSOR_REPO_CWD=
CURSOR_MODEL=composer-2.5

# cloud のときだけ（例: https://github.com/3rdOne501/loveca-labo）
CURSOR_CLOUD_REPOS=

# true なら Agent を起動せずプロンプトだけ返す
DRY_RUN=false

# true なら Bot メンション必須
REQUIRE_MENTION=false

# Agent 成功後の GitHub 反映
#   off  … しない
#   pr   … 新ブランチに commit/push → gh pr create
#   push … 現在ブランチへ commit/push（既定・直適用）
GITHUB_APPLY_MODE=push
# pr のときだけ使う base（push では不要）
GITHUB_BASE_BRANCH=main
