{
  "name": "loveca-labo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Loveca Labo — 非公式デッキ構築・ソロツール（Windows / Mac / Linux のモダンブラウザ向け）",
  "scripts": {
    "start": "npx --yes serve . -l 8080",
    "github:sync": "bash scripts/sync-github.sh --fast",
    "github:sync:full": "bash scripts/sync-github.sh",
    "audit:abilities": "node scripts/audit-ability-semantics.mjs",
    "audit:abilities:check": "node scripts/audit-ability-semantics.mjs --check",
    "audit:abilities:strict": "node scripts/audit-ability-semantics.mjs --strict",
    "test:ability-audit": "node scripts/verify-ability-semantics.mjs",
    "test:abilities": "node scripts/verify-ability-coverage.mjs",
    "test:muse-duo-baton": "node scripts/verify-muse-duo-baton.mjs",
    "test:pending-abilities": "node scripts/verify-pending-abilities.mjs"
  }
}
